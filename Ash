      document.getElementById('resultSection').style.display = 'block';
      document.getElementById('resultSection').scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function playAudio(lang) {
      if (!currentData) return;
      const isHi = lang === 'hi';
      const speaker = isHi ? 'anand' : 'aditya';
      const langCode = isHi ? 'hi-IN' : 'en-IN';
      const text = isHi ? (currentData.audio_script_hi || currentData.name) : (currentData.audio_script_en || currentData.name);

      document.getElementById('transcriptBox').style.display = 'block';
      document.getElementById('tLabel').textContent = isHi ? 'हिन्दी विवरण (Anand):' : 'English Narration (Aditya):';
      document.getElementById('tText').textContent = text;
      document.getElementById('btnEn').classList.toggle('active-play', !isHi);
      document.getElementById('btnHi').classList.toggle('active-play', isHi);

      if (audioCache[lang]) {
        document.getElementById('audioStatus').textContent = `Playing ${isHi ? 'हिन्दी' : 'English'} with Sarvam Bulbul...`;
        audioEl.src = audioCache[lang];
        audioEl.play();
        return;
      }

      document.getElementById('audioStatus').textContent = `Synthesizing ${isHi ? 'शुद्ध हिन्दी' : 'English'} with Sarvam Bulbul...`;
      try {
        const res = await fetch('/api/audio', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ text: text, language_code: langCode, speaker: speaker })
        });
        const d = await res.json();
        if (d.success && d.audio_url) {
          audioCache[lang] = d.audio_url;
          audioEl.src = d.audio_url;
          audioEl.play();
          document.getElementById('audioStatus').textContent = `Playing ${isHi ? 'हिन्दी (Anand)' : 'English (Aditya)'} with Sarvam Bulbul...`;
        }
      } catch(e) { document.getElementById('audioStatus').textContent = 'Audio playback error.'; }
    }

    audioEl.onended = () => {
      document.getElementById('btnEn').classList.remove('active-play');
