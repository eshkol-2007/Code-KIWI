  <script>
    let currentData = null;
    let audioCache = {};
    const audioEl = document.getElementById('audioEl');

    document.getElementById('fileIn').addEventListener('change', (e) => {
      if (e.target.files && e.target.files[0]) uploadFile(e.target.files[0]);
    });

    async function uploadFile(file) {
      const fd = new FormData();
      fd.append('image', file);
      document.getElementById('loader').style.display = 'block';
      try {
        const res = await fetch('/api/analyze', { method: 'POST', body: fd });
        const d = await res.json();
        document.getElementById('loader').style.display = 'none';
        if (d.success) render(d.data);
        else alert('Error: ' + (d.error || 'Failed'));
      } catch(e) { document.getElementById('loader').style.display = 'none'; alert(e.message); }
    }

    async function scanPreset(id) {
      document.getElementById('loader').style.display = 'block';
      try {
        const res = await fetch('/api/analyze', {
          method: 'POST',
          headers: {'Content-Type': 'application/json'},
          body: JSON.stringify({ sample_id: id })
        });
        const d = await res.json();
        document.getElementById('loader').style.display = 'none';
        if (d.success) render(d.data);
        else alert('Error: ' + (d.error || 'Failed'));
      } catch(e) { document.getElementById('loader').style.display = 'none'; alert(e.message); }
    }

    function render(data) {
      currentData = data;
      audioCache = {};
      audioEl.pause();
      document.getElementById('btnEn').classList.remove('active-play');
      document.getElementById('btnHi').classList.remove('active-play');
      document.getElementById('transcriptBox').style.display = 'none';
      document.getElementById('audioStatus').textContent = 'Select English or Hindi above to listen';

      document.getElementById('pPhoto').src = data.image_data_uri;
      document.getElementById('pName').textContent = data.name || 'Heritage';
      document.getElementById('pVernacular').textContent = data.vernacular_name || '—';
      document.getElementById('pEra').textContent = data.time_period || 'Ancient';
      document.getElementById('pDynasty').textContent = data.dynasty || '—';
      document.getElementById('pLocation').textContent = data.location || 'India';
      document.getElementById('pUnesco').textContent = data.unesco_status || 'National Heritage';
      document.getElementById('pStampCode').textContent = data.passport_stamp_code || 'IND-ASI-2026';
      document.getElementById('pStampDate').textContent = new Date().toLocaleDateString('en-GB', {day:'2-digit',month:'short',year:'numeric'}).toUpperCase();

      const sanitized = (data.name || 'MONUMENT').toUpperCase().replace(/[^A-Z]/g, '<').slice(0, 24);
      document.getElementById('pMrz').innerHTML = `P&lt;IND${sanitized}&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;<br>IND20261102SARVAM&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;&lt;01`;

      document.getElementById('pMaterials').textContent = data.materials || '—';
      document.getElementById('pCraftStyle').textContent = data.craft_style || '—';
