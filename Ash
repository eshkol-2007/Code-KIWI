@app.route("/")
def index():
    return render_template_string(HTML_TEMPLATE)

@app.route("/api/samples")
def get_samples():
    return jsonify({"samples": SAMPLE_ITEMS})

@app.route("/api/analyze", methods=["POST"])
def analyze_heritage():
    if not client:
        return jsonify({"error": "SARVAM_API_KEY is not configured."}), 500

    image_data_uri = None

    if "image" in request.files:
        file = request.files["image"]
        if file.filename != "":
            raw_bytes = file.read()
            mime_type = file.mimetype or "image/jpeg"
            b64_str = base64.b64encode(raw_bytes).decode("utf-8")
            image_data_uri = f"data:{mime_type};base64,{b64_str}"

    if not image_data_uri and request.is_json:
        data = request.get_json()
        if "sample_id" in data:
            import urllib.request
            sample = next((s for s in SAMPLE_ITEMS if s["id"] == data["sample_id"]), None)
            if sample:
                req = urllib.request.Request(sample["url"], headers={"User-Agent": "Mozilla/5.0"})
                with urllib.request.urlopen(req) as resp:
                    raw_bytes = resp.read()
                image_data_uri = f"data:image/jpeg;base64,{base64.b64encode(raw_bytes).decode('utf-8')}"
        elif "image_data" in data:
            image_data_uri = data["image_data"]

    if not image_data_uri:
        return jsonify({"error": "No image provided."}), 400

    try:
        user_content = [
            {"type": "text", "text": "Analyze this Indian heritage structure or ornament and generate the official Heritage Passport JSON."},
            {"type": "image_url", "image_url": {"url": image_data_uri}}
        ]

        response = client.chat.completions_v2(
            model="gemma4",
            messages=[
                {"role": "system", "content": ANALYSIS_SYSTEM_PROMPT},
                {"role": "user", "content": user_content}
            ],
            response_format={"type": "json_object"},
            temperature=0.2,
            max_tokens=1200
        )

        content = response.choices[0].message.content
        passport_data = json.loads(content)
        passport_data["image_data_uri"] = image_data_uri
        return jsonify({"success": True, "data": passport_data})

    except Exception as e:
        logger.error(f"Analysis error: {str(e)}", exc_info=True)
        return jsonify({"error": str(e)}), 500

@app.route("/api/audio", methods=["POST"])
def generate_audio():
    if not client:
        return jsonify({"error": "Sarvam API client not initialized"}), 500

    data = request.get_json() or {}
    text = data.get("text", "").strip()
    language_code = data.get("language_code", "hi-IN")
    speaker = data.get("speaker", "anand" if language_code == "hi-IN" else "aditya")

    if not text:
        return jsonify({"error": "No text provided for audio narration"}), 400

    text = text[:450].strip()

    try:
        res = client.text_to_speech.convert(
            text=text,
            language_code=language_code,
            speaker=speaker,
            model="bulbul:v3",
            output_audio_codec="mp3"
        )

        if hasattr(res, "audios") and res.audios and len(res.audios[0]) > 0:
            audio_b64 = res.audios[0]
            return jsonify({
                "success": True,
                "language": language_code,
                "speaker": speaker,
                "audio_url": f"data:audio/mp3;base64,{audio_b64}"
            })
        else:
            return jsonify({"error": "No audio returned by Sarvam TTS"}), 500

    except Exception as e:
        logger.error(f"TTS error: {str(e)}", exc_info=True)
        return jsonify({"error": str(e)}), 500

